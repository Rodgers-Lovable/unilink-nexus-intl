# EmailJS form delivery (https://dashboard.emailjs.com)
# Leave unset to run forms in "not configured" mode (details saved locally only).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_CONTACT=
VITE_EMAILJS_TEMPLATE_CONSULTATION=
VITE_EMAILJS_TEMPLATE_PATHWAY=
VITE_EMAILJS_TEMPLATE_APPLICATION=

# Umami analytics (https://umami.is — cloud or self-hosted)
# Leave unset to disable analytics entirely (all tracking calls no-op).
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
