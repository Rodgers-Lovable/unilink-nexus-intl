SITE_URL=

# EmailJS form delivery (https://www.emailjs.com) — client-side via the
# @emailjs/browser SDK, since the site is a static export with no server
# runtime. All vars need the NEXT_PUBLIC_ prefix to be inlined into the
# client bundle at build time. Leave unset to run forms in "not configured"
# mode (details saved locally only).
# In the EmailJS dashboard: Account > Security, add your production domain
# to the allowed origins list (no private key needed for browser sends).
# EMAILJS_NOTIFICATION_TEMPLATE_ID and EMAILJS_AUTOREPLY_TEMPLATE_ID must
# each be an EmailJS template with a {{{html_content}}} body variable and
# {{to_email}} / {{reply_to}} / {{subject}} wired into the template's
# To Email / Reply To / Subject settings.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_NOTIFICATION_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_TO_EMAIL=

# Umami analytics (https://umami.is — cloud or self-hosted)
# Leave unset to disable analytics entirely (all tracking calls no-op).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
