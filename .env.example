# Resend form delivery (https://resend.com) — server-side only, never exposed
# to the browser. Leave unset to run forms in "not configured" mode (details
# saved locally only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Umami analytics (https://umami.is — cloud or self-hosted)
# Leave unset to disable analytics entirely (all tracking calls no-op).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
