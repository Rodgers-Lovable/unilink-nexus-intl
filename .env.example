SITE_URL=

# EmailJS form delivery (https://www.emailjs.com) — server-side only via
# EmailJS's REST API, never exposed to the browser. Leave unset to run forms
# in "not configured" mode (details saved locally only).
# EMAILJS_PRIVATE_KEY requires "Allow EmailJS API for non-browser
# applications" enabled under Account > Security in the EmailJS dashboard.
# EMAILJS_NOTIFICATION_TEMPLATE_ID and EMAILJS_AUTOREPLY_TEMPLATE_ID must
# each be an EmailJS template with a {{{html_content}}} body variable and
# {{to_email}} / {{reply_to}} / {{subject}} wired into the template's
# To Email / Reply To / Subject settings.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_NOTIFICATION_TEMPLATE_ID=
EMAILJS_AUTOREPLY_TEMPLATE_ID=
EMAILJS_TO_EMAIL=

# Umami analytics (https://umami.is — cloud or self-hosted)
# Leave unset to disable analytics entirely (all tracking calls no-op).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
