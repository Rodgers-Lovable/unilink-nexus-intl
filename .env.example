SITE_URL=

# SendGrid form delivery (https://sendgrid.com) — server-side only, never
# exposed to the browser. Leave unset to run forms in "not configured" mode
# (details saved locally only). SENDGRID_FROM_EMAIL must be a verified
# single sender or authenticated domain in SendGrid, or sends will fail.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_TO_EMAIL=

# Umami analytics (https://umami.is — cloud or self-hosted)
# Leave unset to disable analytics entirely (all tracking calls no-op).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
